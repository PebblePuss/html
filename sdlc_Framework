                }

                /* Modal */
                .modal {
                    display: flex;
                    flex-direction: column;

                    gap: 0.6rem;
                    padding: 1.8rem 1.3rem;

                    min-width: 68%;
                    max-height: 75%;

                    background-color: var(--white-color);

