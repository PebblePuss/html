                    padding-right: 0.5rem;

                    color: var(--black-color);

                    font-size: 2rem;

                    overflow-y: auto;
                }

                /* Modal Header */
                .modal-header {
                    display: flex;

                    justify-content: flex-end;
                }

                /* Close Button */
                .close-btn {
                    color: var(--black-color);

                    font-size: 2rem;

                    cursor: pointer;
                }
            </style>
        </template>

        <script>
            class Modal extends Component {
                constructor(target, template = "#template-modal") {
                    super(target, template);
                }

                setEvent() {
                    try {
                        // Close Button 설정
                        this.closeBtn = this.findElement(
                            ".close-btn",
                            "[Modal Warning] Close Button is not exist."
                        );
                        this.closeBtn.addEventListener("click", () => this.destroy());

                        // Modal Overlay 설정
                        this.modalOverlay = this.element;
                        this.modalOverlay.addEventListener("click", () => this.destroy());

                        // Modal Content 설정
                        this.modalContent = this.findElement(
                            ".modal",
                            "[Modal Warning] Modal Content is not exist."
                        );
                        this.modalContent.addEventListener("click", (e) => e.stopPropagation());
                    } catch (error) {
                        console.error(error.message);
                    }
                }

                setBody(templateId) {
                    try {
                        const template = document.querySelector(templateId);
                        if (!template) {
                            throw new Error(`[Modal Error] Template with ID ${templateId} does not exist.`);
                        }

                        const modalBody = this.findElement(
                            ".modal-body",
                            "[Modal Warning] Modal Body is not exist."
                        );

                        // Clear existing content in Modal Body
                        modalBody.innerHTML = "";

                        // Append the template content to Modal Body
                        const content = template.content.cloneNode(true);
                        modalBody.appendChild(content);
                    } catch (error) {
                        console.error(error.message);
                    }
                }
            }

            class ModalBtn extends Component {
                constructor(target, modalBodyId, template = "#template-modal-btn") {
                    super(target, template);
                    this.modalBodyId = modalBodyId; // Store the template ID
                }

                setText(text) {
                    this.textField = this.findElement(
                        ".btn-text",
                        "[ModalBtn Warning] ModalBtn text is not exist."
                    );

                    this.textField.textContent = text;
                }

                setGrid(row, column) {
                    this.element.style.gridColumn = column;
                    this.element.style.gridRow = row;
                }

                setEvent() {
                    this.element.addEventListener("click", () => {
                        const modal = new Modal(`.${containerID}`);

                        try {
                            modal.setBody(this.modalBodyId); // Pass the template ID to Modal
                        } catch (error) {
                            console.error(`[Modal Error] Failed to set Modal Body: ${error}`);
                        }
                    });
                }
            }
        </script>
