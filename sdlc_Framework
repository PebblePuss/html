        <style>
            /* ROOT COLOR DEFINE */
            :root {
                --doosan-main-color     : #005EBD;
                --doosan-main-color-bk  : #004a94;
                --doosan-main-color-bk2 : #003366;

                --doosan-main-color-lt  : #4D8CF5;
                --doosan-main-color-lt2 : #3A78D1;
                --doosan-main-color-lt3 : #2A63AD;

                /* 기존 White, Gray, Black 계열 */
                --white-color           : #f1f1f1;
                --gray-color            : #d9d9d9;
                --gray-color-dark       : #a6a6a6;
                --black-color           : #333333;
                --black-color-dark      : #1a1a1a;

                /* 추가된 Gray 계열 */
                --gray-color-light      : #e6e6e6; /* 밝은 회색 */
                --gray-color-medium     : #bfbfbf; /* 중간 회색 */
                --gray-color-deep       : #8c8c8c; /* 더 어두운 회색 */

                /* 추가된 Black 계열 */
                --black-color-light     : #4d4d4d; /* 밝은 검정 */
                --black-color-medium    : #262626; /* 중간 검정 */
                --black-color-deep      : #0d0d0d; /* 더 어두운 검정 */

                --link-color            : #b2ceea;
                --link-hover-color      : #669ed4;

                --multi-table-color     : #669ed4;

                /* 조정된 Approval ~ SN 색상 */
                --approval-doobuy-color : #F1d0a3; /* 기존 #FAA300에서 조금 더 진하게 */
                --hover-doobuy-color    : #e6ac5e; /* 기존 #FFC14D에서 조금 더 진하게 */
                --approval-doobm-color  : #e4b8b9; /* 기존 #D85F5F에서 조금 더 진하게 */
                --hover-doobm-color     : #cf8383; /* 기존 #FF8080에서 조금 더 진하게 */
                --approval-epms-color   : #9fbfb6; /* 기존 #007F5F에서 조금 더 진하게 */
                --hover-epms-color      : #568F7F; /* 기존 #00A27F에서 조금 더 진하게 */
                --approval-gp-color     : #A9B8D3; /* 기존 #3965C5에서 조금 더 진하게 */
                --hover-gp-color        : #6783B1; /* 기존 #5A85E7에서 조금 더 진하게 */
            }

            /* Global Reset */
            .sdlc-framework-container * {
                box-sizing: border-box;

                margin: 0;
                padding: 0;

                vertical-align: baseline;

                font-size: 100%;
                white-space: wrap;
                word-break: keep-all;

                border: 0;
            }

            /* Legend List */
            #sdlc-legend-list {
                font-family: 'Nanum Gothic', sans-serif;
            }
            
            /* Framework Container */
            #sdlc-framework-container {
                padding: 0.8rem 1.6rem;

                font-family: 'Nanum Gothic', sans-serif;
            }

            /* Footer Hide */
            footer[id="colophon"] {
                display: none;
            }
        </style>

