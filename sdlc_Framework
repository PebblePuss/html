        <script>
            (() => {
                let startCategoryColumn = 2;
                let startProcessColumn = 2;
                let startApprovalColumn = 2;

                Object.keys(sdlcStructure.columns).map(categoryText => {
                    // CATEGORY HEADER SET
                    const category = new Category(`.${containerID}`);
                    const row = sdlcStructure.columns[categoryText].span
                    
                    category.setText(categoryText);
                    category.setGrid('1/2', `${startCategoryColumn}/${startCategoryColumn + row}`);

                    startCategoryColumn += row;

                    // PROCESS HEADER SET
                    sdlcStructure.columns[categoryText].process.forEach(processObject => {
                        const process = new ArrowBox(`.${containerID}`);

                        process.setText(processObject.name);
                        process.setTextSize("1.15rem")
                        process.setGrid('2/3', `${startProcessColumn} / ${startProcessColumn + 1}`);
                        process.setColor("var(--gray-color)");

                        startProcessColumn += 1;
                    });

                    //APPROVAL HEADER SET
                    const approvalList = document.createElement("div");

                    approvalList.className = `approval-${categoryText}-list`;
                    approvalList.style.display = "flex"
                    approvalList.style.flexDirection = "row"
                    approvalList.style.gap = "0.4rem";
                    approvalList.style.gridColumn = `${startApprovalColumn} / ${startApprovalColumn + row}`;
                    approvalList.style.gridRow = "3/4"

                    document.querySelector(`.${containerID}`).appendChild(approvalList);
                    
                    sdlcStructure.columns[categoryText].approval.forEach(approvalObject => {
                        const approval = new ArrowBox(`.approval-${categoryText}-list`);

                        approval.setText(approvalObject.name);
                        approval.setTextSize("0.85rem");
                        approval.setColor(approvalObject.systemLegend.color);
                        approval.element.className += ` ` + approvalObject.systemLegend.name.toLowerCase().trim().replace(/\s+/g, '');
                    });

                    startApprovalColumn += row;
                });
            })();

            (() => {
                let startRow = 1;

                sdlcStructure.rows.forEach(row => {
                    const rowHeader = new ModalBtn(
                        `.${containerID}`,
                        `#template-modal-${row.id}-body` // Pass the template ID
                    );

                    rowHeader.setText(row.name);
                    rowHeader.setGrid(`${startRow}/${startRow + row.span}`, "1/2");

                    startRow += row.span;
                });
            })();
