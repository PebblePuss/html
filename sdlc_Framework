        <div id="content"></div>

        <script>
            (() => {
                const sdlcHeader = document.querySelector("#sdlc-header");
                document.getElementById("content").appendChild(sdlcHeader.content.cloneNode(true));
            })();

            const containerID = 'sdlc-framework-container';
            (() => {
                const wordPressContent = document.querySelector(".sdlc-header");
                const sdlcLegendList = document.createElement("div");

                wordPressContent.style.display = "flex";
                wordPressContent.style.gap = "0.6rem";

                sdlcLegendList.id = "sdlc-legend-list";
                sdlcLegendList.style.display = "flex";
                sdlcLegendList.style.flexDirection = "row";
                sdlcLegendList.style.gap = "0.6rem";
                sdlcLegendList.style.justifyContent = "flex-end";

                Object.keys(systemLegend).forEach(key => {
                    const sdlcLegend = document.createElement("div");

                    sdlcLegend.id = `sdlc-legend-${systemLegend[key].name}`;
                    sdlcLegend.className = `sdlc-legend-btn`;
                    sdlcLegend.innerText = systemLegend[key].name;
                    sdlcLegend.style.backgroundColor = systemLegend[key].color;
                    sdlcLegend.style.color = "var(--black-color)"
                    sdlcLegend.style.cursor = "pointer";

                    // Mouseover 이벤트 추가
                    sdlcLegend.addEventListener("mouseover", () => {
                        const approvalList = document.querySelectorAll(`.arrow-box.${systemLegend[key].name.toLowerCase().trim().replace(/\s+/g, '')}`);

                        sdlcLegend.style.backgroundColor = `${systemLegend[key].hoverColor}`;
                        sdlcLegend.style.color= `var(--white-color)`;
                        
                        // NodeList의 각 요소에 스타일 적용
                        approvalList.forEach(approval => {
                            approval.style.fontWeight = 'bold'; // 텍스트를 굵게
                            approval.style.transform = 'scale(1.07)'; // 약간 확대 효과
                            approval.querySelector(".arrow").style.backgroundColor = `${systemLegend[key].hoverColor}`
                            approval.querySelector(".arrow-box-text").style.color= `var(--white-color)`
                            approval.style.transition = 'all 0.3s ease'; // 부드러운 전환 효과
                        });
                    });

                    // Mouseout 이벤트 추가 (강조 효과 제거)
                    sdlcLegend.addEventListener("mouseout", () => {
                        const approvalList = document.querySelectorAll(`.arrow-box.${systemLegend[key].name.toLowerCase().trim().replace(/\s+/g, '')}`);
                        
                        sdlcLegend.style.backgroundColor = `${systemLegend[key].color}`;
                        sdlcLegend.style.color= `var(--black-color)`;

                        // NodeList의 각 요소에 스타일 초기화
                        approvalList.forEach(approval => {
                            approval.style.fontWeight = ''; // 원래 굵기로 복원
                            approval.style.transform = ''; // 원래 크기로 복원
                            approval.querySelector(".arrow").style.backgroundColor = `${systemLegend[key].color}`
                            approval.querySelector(".arrow-box-text").style.color= `var(--black-color)`
                            approval.style.transition = ''; // 원래 전환 효과로 복원
                        });
                    });

                    sdlcLegendList.appendChild(sdlcLegend);
                });

                wordPressContent.appendChild(sdlcLegendList);
            })();

            (() => {
                const container = document.createElement('div');
                const categoryFR = "0.2fr";
                const processFR = "0.34fr";
                const approvalFR = "0.4fr";
                const rowHeaderFR = "0.6fr";

                container.id = containerID
                container.className = containerID

                const totalProcess = Object.keys(sdlcStructure.columns).reduce((total, key) => {
                    return total + (sdlcStructure.columns[key].span || 0);
                }, 0);

                const totalDataRows = 3;

                container.style.display = 'grid'
                container.style.gridTemplateColumns = `${rowHeaderFR} 1.3fr repeat(${totalProcess - 2}, 1fr) 1.88fr`;
                container.style.gridTemplateRows = `${categoryFR} ${processFR} ${approvalFR} repeat(${totalDataRows}, 0.5fr) `;
                container.style.gap = '0.6rem';

                document.querySelector("#content").appendChild(container);
            })();

            class Component {
                constructor(target, template) {
                    this.init(target, template);
                    this.render();
                }

                init(target, template) {
                    this.container = target.toLowerCase() === "body"
                        ? document.body
                        : document.querySelector(target);
                        
                    this.template = document.querySelector(template)?.content?.cloneNode(true);
                    this.element = this.template.firstElementChild;
                }

                setEvent() {}

                render() {
                    this.container.appendChild(this.template);
                    this.setEvent();
                }

                destroy() {
                    this.element?.remove();
                }

                findElement(selector, errorMessage) {
                    const element = this.element.querySelector(selector);
                    if (!element) {
                        throw new Error(errorMessage);
                    }
                    return element;
                }
            }
        </script>

        <template id="template-modal">
            <div class="modal-overlay">
